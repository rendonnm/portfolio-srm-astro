---
import Header from "@/sections/Header.astro";
import Footer from "@/sections/Footer.astro";
import Background from "@/components/Background.astro";
import Analytics from "@vercel/analytics/astro";

const { copy } = Astro.props;
const isEnglish = Astro.url.pathname.startsWith("/en");
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? Astro.url.origin;
const canonicalUrl = `${siteUrl}${isEnglish ? "/en/" : "/"}`;
const socialImageUrl = new URL("/og-image.jpg", `${siteUrl}/`).toString();
const seo = copy.seo;
---

<!doctype html>
<html lang={seo.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="keywords" content={seo.keywords} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={`${siteUrl}/`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Santiago Rendón Múnera",
        url: canonicalUrl,
        jobTitle: seo.jobTitle,
        address: {
          "@type": "PostalAddress",
          addressLocality: "Medellín",
          addressCountry: "CO",
        },
        sameAs: [
          "https://github.com/rendonnm",
          "https://linkedin.com/in/rendonnm",
        ],
      })}
    />
  </head>

  <body class="relative min-h-screen w-full">
    <a
      href="#main-content"
      class="bg-white text-blue-700 px-3 py-1 font-semibold absolute -top-100 focus:top-0 transition-all"
      >Skip to main content</a
    >
    <Background />
    <Header copy={copy} />

    <main
      class="px-4 relative section py-14 sm:py-20 scroll-m-20 w-full mx-auto container lg:max-w-5xl md:max-w-3xl overflow-hidden"
      id="main-content"
    >
      <section aria-label="Hero">
        <slot />
      </section>
    </main>

    <Footer copy={copy} />
    <Analytics />
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
  }
  @font-face {
    font-family: "NunitoSans";
    src: url("/NunitoSans.ttf") format("truetype");
    font-display: swap;
  }

  @font-face {
    font-family: "Orbitron";
    src: url("/Orbitron.ttf") format("truetype");
    font-display: swap;
  }

  html,
  body {
    background-color: transparent;
    font-family: "NunitoSans", sans-serif;
    color: white;
  }
  :root {
    background-color: black;
    scroll-behavior: smooth;
  }
</style>
